# ═══════════════════════════════════════════════════════════
# Zetheta Platform — Environment Configuration
# ═══════════════════════════════════════════════════════════

# ─── Database (Neon PostgreSQL) ───
# Local development with Docker Postgres (optional fallback):
# DATABASE_URL=postgresql+asyncpg://zetheta:zetheta@postgres:5432/zetheta
#
# Production / Live (Neon):
# 1. Go to https://neon.tech → Create Project
# 2. Copy the connection string from Dashboard → Connection Details
# 3. Replace "postgresql://" with "postgresql+asyncpg://" for SQLAlchemy async
# Example:
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/zetheta?sslmode=require

# ─── Redis / Valkey / Upstash ───
# Local development (Docker Compose uses Valkey container):
# REDIS_URL=redis://valkey:6379
#
# Production / Live (Upstash Redis):
# 1. Go to https://console.upstash.com → Create Database
# 2. Choose region closest to your backend deployment
# 3. Go to "Database Details" → "Redis" tab
# 4. Copy the "redis://..." URL (NOT the REST API URL)
# Example:
REDIS_URL=rediss://default:password@host.upstash.io:6379

# ─── Auth Secrets ───
# Generate strong random strings (min 32 chars each):
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-with-256-bit-secret-min-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Cross-app token HMAC secret (generate separately from JWT_SECRET):
CROSS_APP_SECRET=replace-with-another-256-bit-secret

# ─── Service URLs (for Docker Compose internal networking) ───
AUTH_SERVICE_URL=http://auth-service:8000
API_GATEWAY_URL=http://api-gateway:8000

# ─── Worker ───
WORKER_ID=worker-1

# ─── Frontend URLs ───
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:3001
NEXT_PUBLIC_ASSESSMENT_ENGINE_URL=http://localhost:4001
