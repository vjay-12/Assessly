# Database (Neon PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.neon.tech/zetheta?sslmode=require

# Valkey / Redis
REDIS_URL=redis://valkey:6379

# Auth Secrets (generate strong random values)
JWT_SECRET=your-256-bit-secret-minimum-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Cross-App Token Secret (generate strong random value)
CROSS_APP_SECRET=another-256-bit-secret-for-hmac-signing
CROSS_APP_TOKEN_EXPIRE_SECONDS=120

# Service URLs (for Docker Compose networking)
AUTH_SERVICE_URL=http://auth-service:8000
API_GATEWAY_URL=http://api-gateway:8000

# Worker
WORKER_ID=worker-1

# Frontend
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:3001
